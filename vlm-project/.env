# Environment Variables for VLM Fine-Tuning & Serving

# Model & Cache Configurations
MODEL_ID="Qwen/Qwen2.5-VL-7B-Instruct"
BASE_MODEL_DIR="./models/base/qwen2.5-vl-7b"
ADAPTER_DIR="./models/adapters/prescription-vlm"
MERGED_DIR="./models/merged/prescription-vlm"
DATA_DIR="./data"

# GPU & Training Device
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
TOKENIZERS_PARALLELISM=false

# Hugging Face Access (optional for gated models)
# HF_TOKEN="your_hf_token_here"

# API Service
API_HOST="0.0.0.0"
API_PORT=8080
API_WORKERS=1
